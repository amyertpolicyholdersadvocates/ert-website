---
// Preline accordion item, adapted from the ScrewFast theme.
import Icon from './Icon.astro';
interface Props {
  id: string;
  question: string;
  open?: boolean;
}
const { id, question, open = false } = Astro.props;
---

<div class={`hs-accordion border-b border-slate-200 py-5 ${open ? 'active' : ''}`} id={`${id}-heading`}>
  <button
    class="hs-accordion-toggle group inline-flex w-full items-center justify-between gap-x-3 text-start font-serif text-lg font-semibold text-navy-900 transition hover:text-gold-700"
    aria-expanded={open ? 'true' : 'false'}
    aria-controls={id}
  >
    {question}
    <Icon name="chevronDown" class="size-5 shrink-0 text-gold-600 transition hs-accordion-active:rotate-180" />
  </button>
  <div id={id} role="region" aria-labelledby={`${id}-heading`} class={`hs-accordion-content w-full overflow-hidden transition-[height] duration-300 ${open ? '' : 'hidden'}`}>
    <div class="pt-3 text-slate-600"><slot /></div>
  </div>
</div>
