---
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Before you accept the insurance company’s decision, get a second look.',
  text = 'A denial or a low estimate is not always the final word. Send us the details and we will let you know whether we can help, at no cost to you.',
} = Astro.props;
---

<section class="container-x py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-3xl bg-navy-900 px-6 py-12 sm:px-12 sm:py-14">
    <div class="pointer-events-none absolute -bottom-20 -left-20 size-80 rounded-full bg-gold-500/20 blur-3xl"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg text-navy-200">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-2 lg:justify-end">
        <Button href="/contact#request-help" size="lg" arrow>Request a Free Claim Review</Button>
        <Button href="/how-it-works" variant="outlineLight" size="lg">How It Works</Button>
      </div>
    </div>
  </div>
</section>
