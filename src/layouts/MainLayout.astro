---
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { SITE, LICENSES, ADJUSTER } from '@data/site';
import '@styles/global.css';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Hide the sticky mobile "Get a Free Claim Review" bar (e.g. on the contact page). */
  hideMobileCta?: boolean;
}

const { title, description = SITE.description, noindex = false, hideMobileCta = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | Licensed Public Adjusters`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const ogImage = new URL('/og-image.png', SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.legalName,
  url: SITE.url,
  ...(SITE.phone ? { telephone: SITE.phone } : {}),
  description: SITE.description,
  image: ogImage,
  priceRange: 'Contingency fee',
  areaServed: LICENSES.map(l => ({ '@type': 'State', name: l.state })),
  employee: { '@type': 'Person', name: ADJUSTER.name, jobTitle: ADJUSTER.title },
};
---

<!doctype html>
<html lang="en" class="lenis lenis-smooth scroll-pt-28">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f1b33" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script>
      import '../scripts/lenis.js';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-700 selection:bg-gold-200 selection:text-navy-950">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-gold-400 focus:px-4 focus:py-2 focus:text-navy-950">
      Skip to content
    </a>
    <Navbar />
    <main id="main" class="-mt-[76px] grow sm:-mt-[80px]">
      <slot />
    </main>
    <Footer />

    {/* Mobile-only sticky call to action. Hidden while the request form is on screen. */}
    {!hideMobileCta && (
      <div id="mobile-cta" style="transform: translateY(110%)" class="fixed inset-x-0 bottom-0 z-40 border-t border-navy-900/10 bg-white/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(15,27,51,0.08)] backdrop-blur transition-transform duration-300 md:hidden">
        <a href={Astro.url.pathname === '/' ? '#request-help' : '/contact#request-help'} class="flex w-full items-center justify-center gap-2 rounded-lg bg-gold-400 px-4 py-3 text-base font-semibold text-navy-950 shadow-sm active:bg-gold-300">
          Get a Free Claim Review
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <div class="h-20 bg-navy-950 md:hidden" aria-hidden="true"></div>
    )}
    <script>
      const bar = document.getElementById('mobile-cta');
      const form = document.getElementById('request-help');
      if (bar) {
        // Show after the visitor scrolls past the hero; hide while the form is on screen.
        let formVisible = false;
        const update = () => {
          const show = window.scrollY > window.innerHeight * 0.8 && !formVisible;
          bar.style.transform = show ? '' : 'translateY(110%)';
        };
        if (form && 'IntersectionObserver' in window) {
          new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; update(); }, { rootMargin: '0px 0px -20% 0px' }).observe(form);
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
    <script>
      import 'preline';
      const init = () => (window as any).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
  </body>
</html>
