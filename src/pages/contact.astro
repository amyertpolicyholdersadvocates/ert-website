---
import MainLayout from '@layouts/MainLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContactForm from '@components/ContactForm.astro';
import Icon from '@components/Icon.astro';
import { SITE, LICENSES, ADJUSTER, statesSentence } from '@data/site';
---

<MainLayout title="Contact" description="Request a free claim review from ERT Policyholders Advocates.">
  <PageHero eyebrow="Contact" title="Request a free claim review." lead="Tell us a little about your loss. There is no cost and no obligation." crumbs={[{ label: 'Contact' }]} />

  <section id="request-help" class="container-x scroll-mt-28 py-16 sm:py-20">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="min-w-0 lg:col-span-2"><ContactForm /></div>
      <aside class="space-y-6">
        <div class="card">
          <h2 class="text-xl font-semibold text-navy-900">How to reach us</h2>
          <p class="mt-4 flex items-start gap-3 text-sm text-slate-600">
            <span class="icon-tile !size-10 shrink-0"><Icon name="shield" class="size-5" /></span>
            <span>The form goes straight to {ADJUSTER.name}. To protect our clients from phishing and spam, we do not publish email addresses. We will reply from our business address after you reach out.</span>
          </p>
          {SITE.phone && (
            <a href={`tel:${SITE.phone.replace(/[^0-9+]/g, '')}`} class="mt-3 flex items-center gap-3 text-navy-800 hover:text-gold-700">
              <span class="icon-tile !size-10"><Icon name="phone" class="size-5" /></span>{SITE.phone}
            </a>
          )}
          <p class="mt-4 flex items-start gap-3 text-sm text-slate-600">
            <Icon name="mapPin" class="mt-0.5 size-5 shrink-0 text-gold-600" />Serving residential policyholders in {statesSentence}.
          </p>
        </div>
        <div class="card">
          <h2 class="text-xl font-semibold text-navy-900">Helpful to have ready</h2>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            {['Your insurance policy or declarations page', 'Your claim number, if you have one', 'Photos or video of the damage', 'Any letters or estimates from your insurer'].map(i => (
              <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-gold-600" />{i}</li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-slate-500">You do not need any of this to reach out. It just helps.</p>
        </div>
        <div class="rounded-2xl bg-navy-900 p-6 text-sm text-navy-200">
          <p class="font-semibold text-white">{ADJUSTER.name}, {ADJUSTER.title}</p>
          <p class="mt-2">{LICENSES.map(l => `${l.abbr} #${l.number}`).join(' · ')} · NPN {ADJUSTER.npn}</p>
        </div>
      </aside>
    </div>
  </section>
</MainLayout>
