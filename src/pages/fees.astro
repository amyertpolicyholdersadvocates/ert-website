---
import MainLayout from '@layouts/MainLayout.astro';
import PageHero from '@components/PageHero.astro';
import Icon from '@components/Icon.astro';
import CtaBand from '@components/CtaBand.astro';

---

<MainLayout title="Fees" description="ERT Policyholders Advocates works on a contingency fee with no upfront cost.">
  <PageHero eyebrow="Our fee" title="Contingency fee. No upfront cost." lead="A simple, transparent fee that only gets paid when your claim pays." crumbs={[{ label: 'Fees' }]} />

  <section class="container-x py-16 sm:py-20">
    <div class="grid gap-6 md:grid-cols-3">
      {[
        ['dollar', 'Nothing out of pocket', 'There is no charge for the initial claim review and no retainer to get started.'],
        ['checkCircle', 'Only on what we help obtain', 'Our fee applies only to the insurance proceeds we help obtain. Nothing on amounts paid before you hired us, and if there is no recovery, you owe us nothing.'],
        ['document', 'In writing, up front', 'The fee is disclosed in our written contract before any work begins, and never exceeds the limits set by your state.'],
      ].map(([icon, t, d]) => (
        <div class="card">
          <span class="icon-tile"><Icon name={icon as any} /></span>
          <h2 class="mt-5 text-xl font-semibold text-navy-900">{t}</h2>
          <p class="mt-3 text-slate-600">{d}</p>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-16 max-w-3xl rounded-3xl bg-navy-900 p-8 text-white sm:p-10">
      <p class="eyebrow !text-gold-300">Simple example</p>
      <h2 class="mt-2 text-2xl font-semibold">What "only on what we help obtain" means</h2>
      <p class="mt-4 text-navy-200">
        Say your insurance company offered $20,000 before you contacted us. With our help, the claim is resolved at $50,000. Our fee applies only to the $30,000 increase we helped obtain, never to the original $20,000.
      </p>
      <p class="mt-4 text-sm text-navy-300">For illustration only. Your fee and how it is calculated are spelled out in your written contract and governed by state law.</p>
    </div>
  </section>

  <CtaBand title="Find out if we can help, at no cost." />
</MainLayout>
