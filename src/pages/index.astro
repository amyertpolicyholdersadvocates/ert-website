---
import MainLayout from '@layouts/MainLayout.astro';
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ContactForm from '@components/ContactForm.astro';
import CtaBand from '@components/CtaBand.astro';
import AccordionItem from '@components/AccordionItem.astro';
import { SITE, ADJUSTER, LICENSES, statesSentence } from '@data/site';
import { CLAIMS } from '@data/claims';
import { STEPS } from '@data/process';
import { FAQS } from '@data/faqs';

const whatWeDo = [
  {
    icon: 'document',
    title: 'We read the fine print',
    text: 'We go through your policy and the insurance company’s letters to identify every coverage, limit, and deadline that applies to your loss, so you know exactly what you are entitled to.',
  },
  {
    icon: 'search',
    title: 'We find the gaps',
    text: 'We compare the insurer’s estimate line by line against your contractor’s estimate, your photos, and your receipts, and flag what was missed, underpriced, or left out, including hidden damage.',
  },
  {
    icon: 'chat',
    title: 'We handle the insurer',
    text: 'We present the claim, handle the back and forth with the insurance company, track deadlines, and negotiate for a fair settlement so you can focus on your family.',
  },
] as const;

const whenToCall = [
  { icon: 'xCircle', title: 'Your claim was denied', text: 'A denial letter is not always the end. We review the reason against your policy and the facts.' },
  { icon: 'trendDown', title: 'The insurance offer doesn’t cover my repairs', text: 'If the estimate will not cover real repair costs, we find out why and build the case for more.' },
  { icon: 'clock', title: 'Your claim is stuck', text: 'Weeks without answers? We keep the process moving and hold the insurer to its timelines.' },
  { icon: 'home', title: 'They want to repair instead of replace damages', text: 'A patch is not always a fix. When materials cannot be matched or the damage runs deeper, we push for replacement.' },
  { icon: 'document', title: 'You do not understand your policy', text: 'Coverages, exclusions, and deductibles are confusing. We explain what applies to your loss.' },
  { icon: 'shield', title: 'Before you file', text: 'Starting with an advocate helps you avoid early mistakes that can shrink a claim later.' },
] as const;

const whoWeHelp = [
  { icon: 'home', title: 'Homeowners', text: 'Single-family homeowners dealing with water, fire, storm, or catastrophe damage.' },
  { icon: 'building', title: 'Condo & Townhome Owners', text: 'Unit owners who need help sorting out their own policy alongside the association’s coverage.' },
  { icon: 'key', title: 'Rental Property Owners', text: 'Landlords with damaged residential rentals, including lost rental income where covered.' },
] as const;
---

<MainLayout>
  {/* HERO */}
  <section class="relative overflow-hidden bg-navy-950 pt-36 pb-20 text-white sm:pt-44 sm:pb-28">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="pointer-events-none absolute -top-32 right-0 size-[34rem] rounded-full bg-gold-500/15 blur-3xl"></div>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-gold-400/40 bg-white/5 px-3 py-1 text-xs font-semibold tracking-wider text-gold-300 uppercase">
          <Icon name="shield" class="size-4" /> Licensed Public Adjusters · {LICENSES.map(l => l.abbr).join(' · ')}
        </p>
        <h1 class="mt-6 text-5xl leading-[1.05] font-semibold sm:text-6xl lg:text-7xl">
          <span class="block"><span class="text-gold-400">E</span>xpertise.</span>
          <span class="block"><span class="text-gold-400">R</span>epresentation.</span>
          <span class="block"><span class="text-gold-400">T</span>rust.</span>
        </h1>
        <p class="mt-6 font-serif text-2xl text-white sm:text-3xl">A licensed public adjuster on your side of the property claim.</p>
        <p class="mt-4 max-w-2xl text-lg text-pretty text-navy-200">
          Your insurance company has adjusters working for them. {SITE.name} works for you. We help homeowners recover what their policy promises after water, fire, storm, and catastrophe losses.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="#request-help" size="lg" arrow>Request a Free Claim Review</Button>
          <Button href="/how-it-works" variant="outlineLight" size="lg">See How It Works</Button>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-navy-100">
          <li class="flex items-center gap-2"><Icon name="checkCircle" class="size-5 text-gold-400" />We work for policyholders</li>
          <li class="flex items-center gap-2"><Icon name="checkCircle" class="size-5 text-gold-400" />No upfront cost</li>
          <li class="flex items-center gap-2"><Icon name="checkCircle" class="size-5 text-gold-400" />{SITE.feePercent}% contingency fee</li>
        </ul>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl backdrop-blur sm:p-8">
          <p class="eyebrow !text-gold-300">What we handle for you</p>
          <ul class="mt-5 space-y-4">
            {[
              ['camera', 'Evidence organized for you', 'Photos, receipts, and contractor estimates in one claim.'],
              ['search', 'Insurer estimate review', 'Compared line by line to your contractor’s numbers.'],
              ['document', 'Policy and coverage review', 'What applies, what was missed.'],
              ['chat', 'Negotiation with the insurer', 'We do the back and forth for you.'],
            ].map(([icon, t, d]) => (
              <li class="flex gap-4">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-gold-400 text-navy-950">
                  <Icon name={icon as any} class="size-5" />
                </span>
                <span>
                  <span class="block font-semibold text-white">{t}</span>
                  <span class="block text-sm text-navy-200">{d}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="mt-6 rounded-2xl bg-gold-400/10 p-4 ring-1 ring-gold-400/30">
            <p class="text-sm text-gold-100">
              <span class="font-serif text-2xl font-semibold text-gold-300">{SITE.feePercent}%</span> of the insurance proceeds we help obtain, paid only when your claim pays. Nothing out of pocket to get started.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WHAT A PUBLIC ADJUSTER DOES */}
  <section class="container-x py-20 sm:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <SectionHeader
        align="left"
        eyebrow="What is a public adjuster?"
        title="We work for policyholders, not insurance companies."
        lead="The adjuster your insurance company sends works for the insurance company. A public adjuster is a state-licensed professional you hire to represent your interests in the claim from start to finish."
      />
      <div class="space-y-4">
        {[
          'Organize the evidence of everything that was damaged',
          'Read your policy and identify every coverage that applies',
          'Compare the insurer’s estimate against your contractor’s and your policy',
          'Negotiate with the insurance company on your behalf',
        ].map(item => (
          <div class="flex items-start gap-3 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <Icon name="checkCircle" class="mt-0.5 size-6 shrink-0 text-gold-600" />
            <p class="font-medium text-navy-900">{item}</p>
          </div>
        ))}
        <div class="rounded-xl border-l-4 border-gold-500 bg-navy-900 p-5 text-navy-100">
          <p><span class="font-semibold text-gold-300">Our approach:</span> if your policy covers it, it belongs in the claim, whether you can see it or not.</p>
        </div>
      </div>
    </div>
  </section>

  {/* WHAT ERT DOES */}
  <section class="bg-white py-20 sm:py-24">
    <div class="container-x">
      <SectionHeader eyebrow={`What ${SITE.shortName} does`} title="Three things that change the outcome of a claim." />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {whatWeDo.map((item, i) => (
          <div class="card relative overflow-hidden">
            <span class="absolute top-4 right-5 font-serif text-6xl font-bold text-navy-50">0{i + 1}</span>
            <span class="icon-tile relative"><Icon name={item.icon} /></span>
            <h3 class="relative mt-5 text-xl font-semibold text-navy-900">{item.title}</h3>
            <p class="relative mt-3 text-slate-600">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* WHEN TO CALL */}
  <section class="container-x py-20 sm:py-24">
    <SectionHeader eyebrow="When should you call?" title="If something about your claim feels wrong, it is worth a conversation." />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {whenToCall.map(item => (
        <div class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-gold-400 hover:shadow-md">
          <Icon name={item.icon} class="size-7 text-gold-600" />
          <h3 class="mt-4 text-lg font-semibold text-navy-900">{item.title}</h3>
          <p class="mt-2 text-slate-600">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <Button href="#request-help" variant="navy" arrow>Talk to an Adjuster</Button>
    </div>
  </section>

  {/* WHO WE HELP */}
  <section class="bg-navy-950 py-20 text-white sm:py-24">
    <div class="container-x">
      <SectionHeader tone="light" eyebrow="Who we represent" title="Residential property owners across three states." lead={`Homeowners and residential property owners in ${statesSentence}.`} />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {whoWeHelp.map(item => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <span class="inline-flex size-12 items-center justify-center rounded-xl bg-gold-400 text-navy-950"><Icon name={item.icon} /></span>
            <h3 class="mt-5 text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 text-navy-200">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CLAIM TYPES */}
  <section id="claim-types" class="container-x py-20 sm:py-24">
    <SectionHeader eyebrow="Losses we handle" title="Water, fire, storm, and catastrophe claims." />
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {CLAIMS.map(c => (
        <a href={`/claims/${c.slug}`} class="group card flex flex-col transition hover:border-gold-400 hover:shadow-md">
          <div class="flex items-center gap-4">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3 class="text-xl font-semibold text-navy-900">{c.navLabel}</h3>
          </div>
          <p class="mt-4 text-slate-600">{c.summary}</p>
          <div class="mt-5 rounded-xl bg-navy-50 p-4 text-sm">
            <p class="font-semibold text-navy-900">Where claims go wrong</p>
            <p class="mt-1 text-slate-600">{c.carrierIssue}</p>
          </div>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-700">
            Learn more <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* PROCESS */}
  <section class="bg-white py-20 sm:py-24">
    <div class="container-x">
      <SectionHeader eyebrow="Our process" title="How a claim review works with ERT." />
      <ol class="mt-14 grid gap-6 md:grid-cols-5">
        {STEPS.map((s, i) => (
          <li class="relative">
            {i < STEPS.length - 1 && <span class="absolute top-6 left-14 hidden h-px w-[calc(100%-2.5rem)] bg-gold-300 md:block"></span>}
            <span class="relative inline-flex size-12 items-center justify-center rounded-full bg-navy-900 font-serif text-lg font-semibold text-gold-400 ring-4 ring-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-navy-900">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.short}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 text-center"><a href="/how-it-works" class="link-gold">Read the full process</a></div>
    </div>
  </section>

  {/* FEES + ADJUSTER */}
  <section class="container-x py-20 sm:py-24">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="card flex flex-col !p-8 sm:!p-10">
        <p class="eyebrow">Our fee</p>
        <p class="mt-4 font-serif text-7xl font-semibold text-navy-900">{SITE.feePercent}<span class="text-gold-500">%</span></p>
        <p class="mt-2 text-lg font-medium text-navy-800">Contingency basis. No upfront cost.</p>
        <p class="mt-4 text-slate-600">
          Our fee is a percentage of the insurance proceeds we help obtain, never of amounts paid before you hired us. If there is no recovery, you owe us nothing. Every fee is disclosed in writing before we begin, and never exceeds the limits set by state law.
        </p>
        <div class="mt-auto pt-6"><a href="/fees" class="link-gold">How our fee works</a></div>
      </div>
      <div class="card flex flex-col !p-8 sm:!p-10">
        <p class="eyebrow">Your adjuster</p>
        <div class="mt-5 flex items-center gap-4">
          <span class="inline-flex size-20 shrink-0 items-center justify-center rounded-full bg-navy-900 font-serif text-2xl font-semibold text-gold-400 ring-4 ring-gold-200">{ADJUSTER.initials}</span>
          <div>
            <h3 class="text-2xl font-semibold text-navy-900">{ADJUSTER.name}</h3>
            <p class="text-sm font-medium text-gold-700">{ADJUSTER.title} · NPN {ADJUSTER.npn}</p>
          </div>
        </div>
        <p class="mt-5 text-slate-600">
          {ADJUSTER.name} represents homeowners in property and casualty claims, bringing careful documentation, clear communication, and steady persistence to every file. When you work with {SITE.shortName}, you work directly with a licensed adjuster who knows your claim.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {LICENSES.map(l => <span class="rounded-full bg-navy-50 px-3 py-1 text-xs font-medium text-navy-800 ring-1 ring-navy-100">{l.state} #{l.number}</span>)}
        </div>
        <div class="mt-auto pt-6"><a href="/about" class="link-gold">Meet {ADJUSTER.name.split(' ')[0]}</a></div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-white py-20 sm:py-24">
    <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-3">
      <SectionHeader align="left" eyebrow="Questions" title="Frequently asked questions." lead="Straight answers about working with a public adjuster." />
      <div class="hs-accordion-group lg:col-span-2">
        {FAQS.slice(0, 6).map((f, i) => (
          <AccordionItem id={`faq-${i}`} question={f.q} open={i === 0}><p>{f.a}</p></AccordionItem>
        ))}
      </div>
    </div>
  </section>

  {/* REQUEST HELP */}
  <section id="request-help" class="container-x scroll-mt-28 py-20 sm:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <SectionHeader align="left" eyebrow="Get a free review" title="Tell us about your claim." lead="Share the basics. It takes a few minutes and costs nothing." />
        <ol class="mt-8 space-y-5">
          {[
            ['We review what you send', 'Usually the same or next business day.'],
            ['We reach out to talk it through', 'A quick call to understand your loss and your policy.'],
            ['We tell you honestly if we can help', 'If your claim is not a good fit, we will say so.'],
            ['If it is a fit, we get to work', 'Policy review, evidence, and claim management.'],
          ].map(([t, d], i) => (
            <li class="flex gap-4">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-400 text-sm font-bold text-navy-950">{i + 1}</span>
              <span><span class="block font-semibold text-navy-900">{t}</span><span class="text-sm text-slate-600">{d}</span></span>
            </li>
          ))}
        </ol>
        <div class="mt-8 flex items-center gap-3 rounded-xl bg-navy-50 p-4 text-sm">
          <Icon name="envelope" class="size-5 shrink-0 text-gold-600" />
          <span>Prefer email? <a class="link-gold" href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
        </div>
      </div>
      <div class="min-w-0 lg:col-span-3"><ContactForm /></div>
    </div>
  </section>

  <CtaBand />
</MainLayout>
